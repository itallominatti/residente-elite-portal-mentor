# Copie para .env.local para rodar localmente.
# A API precisa aceitar a origem do portal no CORS (CORS_ALLOWED_ORIGINS do back-end).
VITE_API_BASE_URL=https://api.residente-elite.com/api/v1

# Funções que dependem de mudanças no elite-med-back-end (veja docs/BACKEND.md).
# Ligue depois que o back-end com o commit 226cc1e da main estiver no ar
# (o mentor passa a ler a revisão de quem atende; antes recebia os próprios dados).
VITE_FEATURE_METRICAS_DO_MENTOR=false

# Contatos, anotações, agenda, plano, carteira com indicadores, estudo do aluno e "ver como" com trilha.
# Ligue depois que o back-end com as migrações 0151 e 0152 estiver no ar (docs/BACKEND.md).
VITE_FEATURE_ACOMPANHAMENTO=false

# Elitinho de apoio ao mentor. NÃO ligue sem a decisão de LGPD (docs/BACKEND.md).
VITE_FEATURE_ELITINHO_DO_MENTOR=false
VITE_ELITINHO_API_URL=
